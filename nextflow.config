/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    RNA-seq Pipeline - Nextflow Config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Pipeline parameters
params {
    // Input/output
    input       = null
    outdir      = 'results'

    // Reference
    star_index  = null
    gtf         = null

    // Pipeline options
    skip_fastqc = false

    // Resource defaults
    max_cpus    = 16
    max_memory  = '64.GB'
    max_time    = '24.h'
}

// Process-specific configuration
includeConfig 'conf/modules.config'

// Execution profiles
profiles {
    docker {
        docker.enabled = true
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        docker.enabled = false
    }
    wave {
        wave.enabled = true
        wave.strategy = 'conda,container'
        docker.enabled = true
    }
    test {
        params.max_cpus   = 2
        params.max_memory = '6.GB'
        params.max_time   = '6.h'
    }
}

// Default process settings
process {
    cpus   = { 1 * task.attempt }
    memory = { 6.GB * task.attempt }
    time   = { 4.h * task.attempt }

    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139, 247] ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'
}

// Manifest
manifest {
    name            = 'rnaseq-pipeline'
    author          = 'Converted from bash by Seqera AI'
    description     = 'Minimal RNA-seq pipeline: FastQC, STAR alignment, featureCounts'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.04.0'
    version         = '1.0.0'
}
