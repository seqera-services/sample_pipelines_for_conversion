/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    RNA-seq Pipeline - Nextflow Configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Pipeline parameters
params {
    // Input/output
    input                = null  // Path to samplesheet CSV
    outdir               = 'results'

    // Reference genome
    fasta                = null  // Path to genome FASTA (for index generation)
    gtf                  = null  // Path to annotation GTF
    star_index           = null  // Path to pre-built STAR index directory

    // Max resource limits
    max_cpus             = 16
    max_memory           = '64.GB'
    max_time             = '48.h'
}

// Process-specific configuration
process {
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: 'copy',
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withLabel: 'process_medium' {
        cpus   = { 4 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }

    withLabel: 'process_high' {
        cpus   = { 8 * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 16.h * task.attempt }
    }

    errorStrategy = 'retry'
    maxRetries    = 2
}

// Profiles
profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
    conda {
        conda.enabled = true
    }
    test {
        params {
            input      = "${projectDir}/test_data/samplesheet.csv"
            fasta      = 'https://github.com/nf-core/test-datasets/raw/rnaseq/reference/genome.fa'
            gtf        = 'https://github.com/nf-core/test-datasets/raw/rnaseq/reference/genes.gtf'
            max_cpus   = 4
            max_memory = '8.GB'
            max_time   = '2.h'
        }
    }
}

// Manifest
manifest {
    name            = 'rnaseq-minimal'
    author          = 'Converted from WDL'
    description     = 'Minimal RNA-seq pipeline: FastQC, STAR alignment, featureCounts'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.04.0'
    version         = '1.0.0'
}

// Timeline, report, trace
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/dag.html"
}
