/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    RNA-seq Pipeline - Nextflow Config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    // Input/output
    reads       = null   // e.g. 'data/*_{R1,R2}.fastq.gz'
    star_index  = null   // Path to STAR index directory
    gtf         = null   // Path to GTF annotation file
    outdir      = 'results'

    // Pipeline options
    skip_fastqc = false

    // Resource defaults
    max_cpus    = 16
    max_memory  = '64.GB'
    max_time    = '24.h'
}

// Process defaults
process {
    cpus   = 1
    memory = '6.GB'
    time   = '4.h'

    withName: 'FASTQC' {
        cpus   = 2
        memory = '4.GB'
    }
    withName: 'STAR_ALIGN' {
        cpus   = 8
        memory = '36.GB'
        time   = '8.h'
    }
    withName: 'SAMTOOLS_INDEX' {
        cpus   = 1
        memory = '4.GB'
    }
    withName: 'FEATURECOUNTS' {
        cpus   = 4
        memory = '8.GB'
    }
}

// Execution profiles
profiles {
    docker {
        docker.enabled = true
    }
    singularity {
        singularity.enabled = true
    }
    conda {
        conda.enabled = true
    }
    test {
        params {
            reads      = "${projectDir}/test_data/reads/*_{R1,R2}.fastq.gz"
            star_index = "${projectDir}/test_data/reference/star_index"
            gtf        = "${projectDir}/test_data/reference/annotation.gtf"
            outdir     = 'results'
            max_cpus   = 4
            max_memory = '8.GB'
        }
    }
}

// Wave container service (enables automatic container provisioning)
wave {
    enabled = true
}

// Timeline, report, and trace
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace.txt"
}

// Manifest
manifest {
    name            = 'rnaseq-pipeline'
    author          = 'Tyler Gross'
    description     = 'Minimal RNA-seq pipeline: FastQC, STAR alignment, featureCounts'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.04.0'
    version         = '1.0.0'
}
