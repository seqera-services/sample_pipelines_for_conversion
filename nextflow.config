/*
 * Nextflow configuration file
 */

manifest {
    name            = 'RNA-seq Pipeline'
    author          = 'Sample Pipeline'
    description     = 'Minimal RNA-seq analysis pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.0'
}

// Default parameters
params {
    // Input/output options
    read1           = null
    read2           = null
    star_index      = null
    annotation      = null
    sample_name     = 'sample1'
    outdir          = 'results'

    // Process options
    threads         = 4
    skip_fastqc     = false

    // Display help message
    help            = false
}

// Process configuration
process {
    // Default resources for all processes
    cpus   = 2
    memory = '8.GB'
    time   = '4.h'

    // Process-specific resources
    withName: FASTQC {
        cpus   = 2
        memory = '2.GB'
    }

    withName: STAR_ALIGN {
        cpus   = params.threads
        memory = '6.GB'
        time   = '6.h'
    }

    withName: SAMTOOLS_INDEX {
        cpus   = 1
        memory = '2.GB'
    }

    withName: FEATURECOUNTS {
        cpus   = params.threads
        memory = '4.GB'
    }
}

// Execution profiles
profiles {
    // Standard profile (local execution)
    standard {
        process.executor = 'local'
    }

    // Docker profile
    docker {
        docker.enabled = true
        process {
            withName: FASTQC {
                container = 'biocontainers/fastqc:v0.11.9_cv8'
            }
            withName: 'STAR_ALIGN|SAMTOOLS_INDEX' {
                container = 'quay.io/biocontainers/mulled-v2-1fa26d1ce03c295fe2fdcf85831a92fbcbd7e8c2:1df389393721fc66f3fd8778ad938ac711951107-0'
            }
            withName: FEATURECOUNTS {
                container = 'quay.io/biocontainers/subread:2.0.1--hed695b0_0'
            }
        }
    }

    // Conda profile
    conda {
        conda.enabled = true
        process {
            conda = 'bioconda::fastqc bioconda::star bioconda::samtools bioconda::subread'
        }
    }
}

// Report options
report {
    enabled = true
    file    = "${params.outdir}/report.html"
}

timeline {
    enabled = true
    file    = "${params.outdir}/timeline.html"
}

trace {
    enabled = true
    file    = "${params.outdir}/trace.txt"
}
