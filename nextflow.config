/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    RNA-seq Pipeline - Nextflow Configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Converted from: config.yaml (Python pipeline)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Pipeline parameters
params {
    // Input options
    input         = null  // Path to sample sheet (CSV/TSV)
    read1         = null  // Direct path to R1 FASTQ (alternative to sample sheet)
    read2         = null  // Direct path to R2 FASTQ (alternative to sample sheet)
    sample_name   = 'sample1'

    // Reference files
    star_index    = null  // Path to STAR index directory
    gtf           = null  // Path to GTF annotation file

    // Output options
    outdir        = 'results'

    // Pipeline options
    skip_fastqc   = false
}

// Process resource defaults
process {
    withLabel: 'process_low' {
        cpus   = 2
        memory = 4.GB
        time   = 1.h
    }
    withLabel: 'process_medium' {
        cpus   = 4
        memory = 8.GB
        time   = 4.h
    }
    withLabel: 'process_high' {
        cpus   = 8
        memory = 32.GB
        time   = 8.h
    }

    // Publish directory configuration
    withName: 'FASTQC' {
        publishDir = [
            path: "${params.outdir}/fastqc",
            mode: 'copy'
        ]
    }
    withName: 'STAR_ALIGN' {
        publishDir = [
            path: "${params.outdir}/star",
            mode: 'copy'
        ]
    }
    withName: 'SAMTOOLS_INDEX' {
        publishDir = [
            path: "${params.outdir}/star",
            mode: 'copy'
        ]
    }
    withName: 'SUBREAD_FEATURECOUNTS' {
        publishDir = [
            path: "${params.outdir}/counts",
            mode: 'copy'
        ]
    }
}

// Execution profiles
profiles {
    docker {
        docker.enabled         = true
        docker.userEmulation   = true
        singularity.enabled    = false
        conda.enabled          = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        conda.enabled          = false
    }
    conda {
        conda.enabled          = true
        docker.enabled         = false
        singularity.enabled    = false
    }
    wave {
        wave.enabled           = true
        wave.strategy          = ['conda', 'container']
        docker.enabled         = true
    }
    test {
        params {
            sample_name = 'test_sample'
            read1       = 'test_data/reads/sample1_R1.fastq.gz'
            read2       = 'test_data/reads/sample1_R2.fastq.gz'
            star_index  = 'test_data/reference/star_index'
            gtf         = 'test_data/reference/annotation.gtf'
            outdir      = 'results'
        }
    }
}

// Manifest
manifest {
    name            = 'rnaseq-pipeline'
    author          = 'Tyler Gross'
    description     = 'Minimal RNA-seq pipeline: FastQC, STAR alignment, featureCounts'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '1.0.0'
}

// Capture execution reports
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/dag.html"
}
