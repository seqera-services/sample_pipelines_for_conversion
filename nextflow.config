/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    RNA-seq Pipeline - Nextflow Configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Converted from: config.yaml (Python pipeline)
    Dynamic resource allocation based on FASTQ file size
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Pipeline parameters
params {
    // Input/Output
    input       = null   // Path to samplesheet CSV (required)
    outdir      = 'results'
    star_index  = null   // Path to STAR genome index (required)
    annotation  = null   // Path to GTF annotation file (required)

    // Pipeline options
    skip_fastqc = false

    // Resource defaults (overridden dynamically by size tier)
    max_cpus    = 16
    max_memory  = '64.GB'
    max_time    = '48.h'
}

// Process configuration with dynamic resource scaling
process {
    // Default error strategy
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139, 247] ? 'retry' : 'finish' }
    maxRetries    = 2

    // -------------------------------------------------------------------
    // Dynamic resource allocation based on FASTQ file size (meta.size_tier)
    // Tier thresholds: small (<1GB), medium (1-5GB), large (>5GB)
    // -------------------------------------------------------------------

    withLabel: 'process_low' {
        cpus   = { meta?.size_tier == 'large' ? 4 : 2 }
        memory = { meta?.size_tier == 'large' ? '8.GB' : '4.GB' }
        time   = '4.h'
    }

    withLabel: 'process_medium' {
        cpus   = {
            meta?.size_tier == 'large'  ? 8 :
            meta?.size_tier == 'medium' ? 4 : 2
        }
        memory = {
            meta?.size_tier == 'large'  ? '32.GB' :
            meta?.size_tier == 'medium' ? '16.GB' : '8.GB'
        }
        time   = {
            meta?.size_tier == 'large'  ? '12.h' :
            meta?.size_tier == 'medium' ? '8.h'  : '4.h'
        }
    }

    withLabel: 'process_high' {
        cpus   = {
            meta?.size_tier == 'large'  ? 16 :
            meta?.size_tier == 'medium' ? 8  : 4
        }
        memory = {
            meta?.size_tier == 'large'  ? '64.GB' :
            meta?.size_tier == 'medium' ? '36.GB' : '16.GB'
        }
        time   = {
            meta?.size_tier == 'large'  ? '24.h' :
            meta?.size_tier == 'medium' ? '12.h' : '6.h'
        }
    }

    // Publish results
    withName: 'FASTQC' {
        publishDir = [
            path: { "${params.outdir}/fastqc" },
            mode: 'copy',
            pattern: '*.{html,zip}'
        ]
    }

    withName: 'STAR_ALIGN' {
        publishDir = [
            [
                path: { "${params.outdir}/star" },
                mode: 'copy',
                pattern: '*.bam{,.bai}'
            ],
            [
                path: { "${params.outdir}/star/log" },
                mode: 'copy',
                pattern: '*Log*'
            ]
        ]
    }

    withName: 'FEATURECOUNTS' {
        publishDir = [
            path: { "${params.outdir}/counts" },
            mode: 'copy',
            pattern: '*.counts.txt{,.summary}'
        ]
    }
}

// Execution profiles
profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    conda {
        conda.enabled = true
    }
    test {
        params {
            max_cpus   = 2
            max_memory = '6.GB'
            max_time   = '6.h'
        }
    }
}

// Manifest
manifest {
    name            = 'rnaseq-pipeline'
    author          = 'Converted from Python by Seqera AI'
    description     = 'Minimal RNA-seq pipeline: FastQC, STAR alignment, featureCounts'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.04.0'
    version         = '1.0.0'
}

// Timeline, report, trace
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
}
