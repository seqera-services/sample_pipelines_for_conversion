/*
 * Nextflow configuration file
 * Compatible with Nextflow 26.04+
 */

manifest {
    name            = 'RNA-seq Pipeline'
    author          = 'Sample Pipeline'
    description     = 'Minimal RNA-seq analysis pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '>=26.04.0'
    version         = '2.0.0'
}

// Default parameters
params {
    // Input/output options
    read1           = null
    read2           = null
    star_index      = null
    annotation      = null
    sample_name     = 'sample1'
    outdir          = 'results'

    // Process options
    threads         = 4
    skip_fastqc     = false

    // Display help message
    help            = false
}

// Container execution (AWS Batch uses Docker by default)
docker.enabled = true

// Process configuration
process {
    // Default resources for all processes
    cpus   = 2
    memory = '8.GB'
    time   = '4.h'

    // Process-specific resources
    withName: FASTQC {
        cpus   = 2
        memory = '2.GB'
    }

    withName: STAR_ALIGN {
        cpus   = params.threads
        memory = '6.GB'
        time   = '6.h'
    }

    withName: SAMTOOLS_INDEX {
        cpus   = 1
        memory = '2.GB'
    }

    withName: FEATURECOUNTS {
        cpus   = params.threads
        memory = '4.GB'
    }
}

// Execution profiles
profiles {
    // Standard profile (local execution with Docker)
    standard {
        process.executor = 'local'
    }
}

// Report options
report {
    enabled   = true
    file      = "${params.outdir}/report.html"
    overwrite = true
}

timeline {
    enabled   = true
    file      = "${params.outdir}/timeline.html"
    overwrite = true
}

trace {
    enabled   = true
    file      = "${params.outdir}/trace.txt"
    overwrite = true
}
